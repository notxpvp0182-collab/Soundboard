<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle dark depth base -->
    <item android:top="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#040406" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Top-lit matte dark faux-3D surface -->
    <item android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#0E1015"
                android:startColor="#1A1D26" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#28FFFFFF" />
        </shape>
    </item>
</layer-list>
