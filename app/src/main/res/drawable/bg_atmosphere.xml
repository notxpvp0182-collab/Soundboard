<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_obsidian_deep" />
        </shape>
    </item>
    <!-- Static top-left subtle aqua radial atmospheric glow (Zero GPU blur overhead) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.15"
                android:centerY="0.12"
                android:endColor="#00000000"
                android:gradientRadius="360dp"
                android:startColor="#1E00E5FF"
                android:type="radial" />
        </shape>
    </item>
    <!-- Static bottom-right deep indigo/purple atmospheric glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.88"
                android:centerY="0.85"
                android:endColor="#00000000"
                android:gradientRadius="420dp"
                android:startColor="#1A6366F1"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
