<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_glass_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <FrameLayout
        android:id="@+id/badgeContainer"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_badge_squircle">

        <View
            android:id="@+id/viewActiveIndicator"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:background="@drawable/ic_sound_wave" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSoundName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:singleLine="true"
            android:text="SOUND TITLE"
            android:textAllCaps="true"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSoundCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_squircle"
                android:letterSpacing="0.1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="SFX"
                android:textAllCaps="true"
                android:textColor="@color/text_primary"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemVolume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.08"
                android:text="VOL 100%"
                android:textColor="@color/text_secondary"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekItemVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnFavorite"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Favorite"
        android:padding="5dp"
        android:src="@drawable/ic_favorite" />

    <ImageButton
        android:id="@+id/btnMoreOptions"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Settings"
        android:padding="5dp"
        android:src="@drawable/ic_settings" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPlayToggle"
        android:layout_width="74dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_3d_button"
        android:letterSpacing="0.08"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="▶ PLAY"
        android:textAllCaps="true"
        android:textColor="@color/text_primary"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
