<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_atmosphere"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <!-- Top Glass Header -->
    <LinearLayout
        android:id="@+id/headerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_sound_wave" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAppSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_tagline"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnAudioRoutingGuide"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Audio Routing Info"
            android:src="@drawable/ic_info" />

        <Button
            android:id="@+id/btnToggleOverlay"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/accent_cyan"
            android:text="@string/overlay_toggle"
            android:textAllCaps="false"
            android:textColor="#041016"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Master Playback & Live Mic Monitor Bar -->
    <LinearLayout
        android:id="@+id/playbackControlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvActiveStreamsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Idle"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekMasterVolume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="90" />

        <TextView
            android:id="@+id/tvMasterVolumeValue"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="90%"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btnMicMonitorToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle Microphone Local Monitor"
            android:src="@drawable/ic_mic" />

        <Button
            android:id="@+id/btnStopAllMain"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/accent_danger"
            android:text="@string/stop_all"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Search & Category Filter Bar (Visible on Soundboard tab) -->
    <LinearLayout
        android:id="@+id/searchAndFilterCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="10dp">

        <EditText
            android:id="@+id/etSearchSounds"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_pill"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chipGroupCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCatAll"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="All"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCatFavorites"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="★ Favorites"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCatRecent"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="Recent"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCatSfx"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="SFX"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCatVoice"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="Voice"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCatMusic"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Music"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Main Dynamic Content Frame -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <!-- TAB 1: SOUNDBOARD GRID -->
        <FrameLayout
            android:id="@+id/viewSoundboardContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSoundGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:id="@+id/emptyStateContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_glass_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sound_wave" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/empty_library_title"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/empty_library_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnImportFirstSound"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/accent_cyan"
                    android:text="+ Import Audio Files"
                    android:textAllCaps="false"
                    android:textColor="#041016"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- TAB 2: COMPLETE SETTINGS SCREEN -->
        <ScrollView
            android:id="@+id/viewSettingsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <!-- PERMISSIONS SECTION -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PERMISSIONS &amp; CAPABILITIES"
                        android:textColor="@color/accent_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPermOverlayStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Floating Overlay Permission"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnGrantOverlay"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Configure"
                            android:textAllCaps="false"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPermMicStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Microphone Monitor Permission"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnGrantMic"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Request"
                            android:textAllCaps="false"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPermNotifStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Background Service Notifications"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnGrantNotif"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Request"
                            android:textAllCaps="false"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- GENERAL & AUDIO SETTINGS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GENERAL &amp; AUDIO ENGINE"
                        android:textColor="@color/accent_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchHapticFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Subtle Haptic Feedback on Tap"
                        android:textColor="@color/text_primary" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchCompactGrid"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Compact 3-Column Sound Grid"
                        android:textColor="@color/text_primary" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAudioFocus"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Request Transient Audio Focus"
                        android:textColor="@color/text_primary" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchVoiceCommMode"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Voice Communication Audio Routing Attribute"
                        android:textColor="@color/text_primary" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchOverlapSounds"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Allow Multi-Sound Overlap (Polyphony)"
                        android:textColor="@color/text_primary" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchStopOnExit"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Stop All Sounds When Closing App"
                        android:textColor="@color/text_primary" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchStartOnBoot"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Auto-Prepare Service on Device Boot"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <!-- OVERLAY & APPEARANCE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FLOATING OVERLAY &amp; APPEARANCE"
                        android:textColor="@color/accent_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOverlayOpacityLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Overlay Opacity: 90%"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/seekOverlayOpacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="90" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchOverlayShowLabels"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Show Full Sound Titles in Overlay"
                        android:textColor="@color/text_primary" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchReducedMotion"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Reduced Motion (Zero UI Animations for 1GB RAM)"
                        android:textColor="@color/text_primary" />

                    <Button
                        android:id="@+id/btnResetOverlayBounds"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:text="Reset Floating Overlay Position &amp; Size"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- TAB 3: ABOUT & PRIVACY SCREEN -->
        <ScrollView
            android:id="@+id/viewAboutContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aura Soundboard"
                    android:textColor="@color/accent_cyan"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAboutVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Version 1.0.0 (Build 1)"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Engineered for 1–2 GB RAM Android devices.\n\n• 100% Offline-First Architecture: This APK does NOT request INTERNET permission. Your audio files and microphone audio never leave your device.\n• Hybrid Audio Engine: Short sound effects trigger via low-latency native SoundPool; long tracks stream directly from storage without filling RAM.\n• Honest Android Audio Routing: Unrooted Android isolates app microphone inputs. Aura provides local mic + soundboard headphone monitoring, voice-communication stream routing, and a floating overlay for hands-free or hardware loopback setups without using root exploits."
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnOpenGithub"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/accent_indigo"
                    android:text="View Source &amp; Releases on GitHub"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Glass Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button
            android:id="@+id/btnNavSoundboard"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Board"
            android:textAllCaps="false"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNavImport"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:backgroundTint="@color/accent_cyan"
            android:text="+ Import"
            android:textAllCaps="false"
            android:textColor="#041016"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNavSettings"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Settings"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnNavAbout"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="About"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
