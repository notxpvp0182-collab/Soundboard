<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MODE 1: ROUND FLOATING BUBBLE ICON -->
    <FrameLayout
        android:id="@+id/overlayBubbleContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_overlay_bubble"
        android:padding="10dp"
        android:visibility="visible">

        <ImageView
            android:id="@+id/ivBubbleIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="Open Floating Soundboard"
            android:src="@drawable/ic_nexu_logo" />
    </FrameLayout>

    <!-- MODE 2: EXPANDED PURE DARK FAUX-3D SOUNDBOARD PANEL -->
    <LinearLayout
        android:id="@+id/overlayBody"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glass_overlay"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/overlayHeader"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_nexu_logo" />

            <TextView
                android:id="@+id/tvOverlayTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:singleLine="true"
                android:text="AURA"
                android:textAllCaps="true"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnOverlayStopAll"
                android:layout_width="32dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_3d_button"
                android:contentDescription="Stop All"
                android:padding="6dp"
                android:src="@drawable/ic_stop" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOverlayMinimize"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_3d_button"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="—"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOverlayClose"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_3d_button"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="✕"
                android:textColor="@color/accent_danger"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/overlayVolumeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="GAIN"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekOverlayMasterVol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="100"
                android:progressTint="#10B981"
                android:thumbTint="#FFFFFF" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOverlaySounds"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvOverlayEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:padding="12dp"
            android:text="NO SOUNDS"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOverlayHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.1"
                android:singleLine="true"
                android:text="TAP TO PLAY • DRAG CORNER"
                android:textAllCaps="true"
                android:textColor="@color/text_muted"
                android:textSize="8sp" />

            <ImageView
                android:id="@+id/btnOverlayResizeHandle"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Resize"
                android:padding="2dp"
                android:src="@drawable/ic_resize" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
