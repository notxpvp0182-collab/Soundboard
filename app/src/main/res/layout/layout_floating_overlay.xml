<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_overlay"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Drag Handle Header -->
    <LinearLayout
        android:id="@+id/overlayHeader"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_sound_wave" />

        <TextView
            android:id="@+id/tvOverlayTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Aura Overlay (Drag)"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnOverlayStopAll"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Stop All Sounds"
            android:src="@drawable/ic_stop" />

        <Button
            android:id="@+id/btnOverlayMinimize"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="42dp"
            android:layout_height="34dp"
            android:padding="0dp"
            android:text="—"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnOverlayClose"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="42dp"
            android:layout_height="34dp"
            android:padding="0dp"
            android:text="✕"
            android:textColor="@color/accent_danger"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Collapsible Overlay Body -->
    <LinearLayout
        android:id="@+id/overlayBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/overlayVolumeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vol"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <SeekBar
                android:id="@+id/seekOverlayMasterVol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="90" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOverlaySounds"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvOverlayEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="12dp"
            android:text="No sounds imported yet."
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Bottom Bar with Corner Resize Touch Handle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOverlayHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tap to play • Drag corner to resize"
                android:textColor="@color/text_muted"
                android:textSize="9sp" />

            <ImageView
                android:id="@+id/btnOverlayResizeHandle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Resize Overlay"
                android:padding="2dp"
                android:src="@drawable/ic_resize" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
