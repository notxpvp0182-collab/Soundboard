<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_dialog"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.14"
        android:text="CONFIGURE SOUND"
        android:textAllCaps="true"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etEditSoundName"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_3d_button"
        android:hint="SOUND NAME"
        android:inputType="textCapWords"
        android:letterSpacing="0.06"
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etEditSoundCategory"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_3d_button"
        android:hint="CATEGORY (SFX / VOICE / MUSIC)"
        android:inputType="textCapWords"
        android:letterSpacing="0.06"
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvEditVolumeValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:letterSpacing="0.1"
        android:text="SOUND GAIN: 100%"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />

    <SeekBar
        android:id="@+id/seekEditVolume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="100"
        android:progressTint="#FFFFFF"
        android:thumbTint="#FFFFFF" />

    <CheckBox
        android:id="@+id/cbEditFavorite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:letterSpacing="0.08"
        android:text="PIN TO FAVORITES (★)"
        android:textAllCaps="true"
        android:textColor="@color/text_primary"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMoveUp"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_3d_button"
            android:letterSpacing="0.08"
            android:text="↑ MOVE UP"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="9sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMoveDown"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_3d_button"
            android:letterSpacing="0.08"
            android:text="↓ MOVE DOWN"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDeleteSound"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_3d_button"
            android:letterSpacing="0.08"
            android:paddingHorizontal="12dp"
            android:text="DELETE"
            android:textAllCaps="true"
            android:textColor="@color/accent_danger"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelEdit"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_3d_button"
            android:letterSpacing="0.08"
            android:paddingHorizontal="12dp"
            android:text="CANCEL"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveEdit"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_3d_button_active"
            android:letterSpacing="0.08"
            android:paddingHorizontal="14dp"
            android:text="SAVE"
            android:textAllCaps="true"
            android:textColor="#000000"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
